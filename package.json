    "pkgroll": "^2.27.0",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "rxdb": "^16"
  }
