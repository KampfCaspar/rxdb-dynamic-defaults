{
  "name": "@kampfcaspar/rxdb-dynamic-defaults",
  "version": "0.1.1",
  "description": "Dynamic Defaults Plugin for RxDB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KampfCaspar/rxdb-dynamic-defaults.git"
